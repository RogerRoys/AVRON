{%- if paginate.pages > 1 -%}
<nav class="pag" aria-label="Pagination">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous">{% render 'icon', name: 'arrow-left' %}</a>{%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next">{% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
</nav>
{%- endif -%}