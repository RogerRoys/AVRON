{%- if localization.available_countries.size > 0 -%}
  {%- form 'localization', id: id, class: 'loc' -%}
    <label class="visually-hidden" for="{{ id }}-country">Country/region</label>
    <select id="{{ id }}-country" name="country_code" onchange="this.form.submit()">
      {%- for c in localization.available_countries -%}
        <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.iso_code }} · {{ c.currency.iso_code }} {{ c.currency.symbol }}</option>
      {%- endfor -%}
    </select>
    <input type="hidden" name="return_to" value="{{ request.path }}">
  {%- endform -%}
{%- else -%}
  <span class="loc">{{ cart.currency.iso_code }} {{ cart.currency.symbol }}</span>
{%- endif -%}