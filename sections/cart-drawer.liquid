{%- liquid
  assign threshold = settings.free_ship_threshold | times: 100
  assign pct = 100
  if threshold > 0 and cart.total_price < threshold
    assign pct = cart.total_price | times: 100 | divided_by: threshold
  endif
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  assign in_cart = ''
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
  assign up = collections[settings.cart_upsell_collection]
-%}
<div class="drawer drawer--right xcd-wrap" id="CartDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Cart">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel xcd" data-cart-inner>
    <div class="xcd__head"><b class="xcd__title">Your cart ({{ cart.item_count }})</b><button type="button" class="xcd__x" data-close aria-label="Close">×</button></div>
    {%- liquid
      assign fs_show = false
      if cart.item_count == 0
        if settings.cart_freeship_empty
          assign fs_show = true
        endif
      elsif settings.cart_show_freeship
        assign fs_show = true
      endif
    -%}
    {%- if fs_show -%}<div class="xcd__ship">
      <span>{%- if pct >= 100 -%}✓ {{ settings.free_ship_text | default: 'You’ve unlocked free tracked shipping' }}{%- else -%}{{ settings.free_ship_away | default: 'You’re [amount] away from free tracked shipping' | replace: '[amount]', remaining_money }}{%- endif -%}</span>
      <div class="xcd__bar"><i style="width:{{ pct }}%"></i></div>
    </div>{%- endif -%}
    <div class="xcd__body">
      {%- if cart.item_count == 0 -%}
        <div class="xcd__empty">
          <span class="xcd__eic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#5C615B" stroke-width="1.6" stroke-linejoin="round"><path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8a3 3 0 016 0"/></svg></span>
          <b>{{ section.settings.empty_heading | default: 'Your cart is empty' }}</b>{%- if section.settings.empty_text != blank -%}<span>{{ section.settings.empty_text }}</span>{%- endif -%}
          {%- if section.settings.empty_btn_show -%}{%- if section.settings.empty_btn_link != blank -%}<a href="{{ section.settings.empty_btn_link }}" class="xcd__cont">{{ section.settings.empty_btn_label }}</a>{%- else -%}<button type="button" class="xcd__cont" data-close>{{ section.settings.empty_btn_label }}</button>{%- endif -%}{%- endif -%}
        </div>
      {%- endif -%}
      {%- for item in cart.items -%}
        <div class="xcd__line">
          <a href="{{ item.url }}" class="xcd__img">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}</a>
          <div class="xcd__info">
            <a href="{{ item.url }}" class="xcd__n">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}<span class="xcd__v">{{ item.variant.title }}</span>{%- endunless -%}
            <div class="xcd__qty">
              <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease">−</button>
              <span>{{ item.quantity }}</span>
              <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase">+</button>
            </div>
          </div>
          <div class="xcd__r"><b>{{ item.final_line_price | money }}</b><button type="button" class="xcd__rm" data-line-change data-line="{{ forloop.index }}" data-qty="0">Remove</button></div>
        </div>
      {%- endfor -%}
      {%- if settings.cart_show_upsell -%}<b class="xcd__uph">{{ settings.cart_upsell_heading | default: 'Customers also added' }}</b>
      <div class="xcd__ups">
        {%- if up != blank and up.products_count > 0 -%}
          {%- assign shown = 0 -%}
          {%- for p in up.products -%}
            {%- assign pid = p.id | append: ',' -%}
            {%- if shown < settings.cart_upsell_count and p.available -%}{%- unless in_cart contains pid -%}
              {%- assign shown = shown | plus: 1 -%}
              <div class="xcd__up">
                <a href="{{ p.url }}" class="xcd__upimg">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</a>
                <a href="{{ p.url }}" class="xcd__upn">{{ p.title }}</a>
                <div class="xcd__uprow"><b>{{ p.price | money }}</b>
                  {%- if p.has_only_default_variant -%}
                    {%- form 'product', p, data-product-form: '' -%}<input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button type="submit" class="xcd__add" data-soldout="false"><span data-add-label data-label="+ Add">+ Add</span></button>{%- endform -%}
                  {%- else -%}
                    <button type="button" class="xcd__add" data-quick-add="{{ p.handle }}">+ Add</button>
                  {%- endif -%}
                </div>
              </div>
            {%- endunless -%}{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="xcd__up"><a href="{{ routes.search_url }}?q=Cordless+Touch+Lamp" class="xcd__upimg">{% render 'demo-img', src: 'av-14.jpg' %}</a><a href="{{ routes.search_url }}?q=Cordless+Touch+Lamp" class="xcd__upn">Cordless Touch Lamp</a><div class="xcd__uprow"><b>{{ 7195 | money }}</b><a href="{{ routes.search_url }}?q=Cordless+Touch+Lamp" class="xcd__add">+ Add</a></div></div>
          <div class="xcd__up"><a href="{{ routes.search_url }}?q=Solar+Globe+Path+Light" class="xcd__upimg">{% render 'demo-img', src: 'av-21.jpg' %}</a><a href="{{ routes.search_url }}?q=Solar+Globe+Path+Light" class="xcd__upn">Solar Globe Path Light</a><div class="xcd__uprow"><b>{{ 4895 | money }}</b><a href="{{ routes.search_url }}?q=Solar+Globe+Path+Light" class="xcd__add">+ Add</a></div></div>
        {%- endif -%}
      </div>{%- endif -%}
    </div>
    {%- if cart.item_count > 0 -%}
      <div class="xcd__foot">
        <div class="xcd__row"><span>Tracked shipping</span><b class="xcd__free">Free</b></div>
        {%- for d in cart.cart_level_discount_applications -%}<div class="xcd__row"><span>{{ d.title }}</span><b>−{{ d.total_allocated_amount | money }}</b></div>{%- endfor -%}
        <div class="xcd__row xcd__row--lg"><b>Subtotal</b><b>{{ cart.total_price | money }}</b></div>
        <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="xcd__co">Checkout securely</button></form>
        {%- if settings.cart_dynamic and additional_checkout_buttons -%}<div class="xcd__dyn">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text",
      "default": "Start with a best seller."
    },
    {
      "type": "checkbox",
      "id": "empty_btn_show",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_btn_label",
      "label": "Button label",
      "default": "Continue shopping"
    },
    {
      "type": "url",
      "id": "empty_btn_link",
      "label": "Button link",
      "info": "Leave blank to just close the cart."
    }
  ]
}
{% endschema %}
