<section class="page-w sec" data-tabs>
  <div class="sec__head">
    <div class="tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="tab" role="tab" data-tab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    {%- assign firstc = section.blocks.first.settings.collection -%}
    {%- if section.settings.view_all_label != blank -%}<a href="{{ firstc.url | default: routes.all_products_collection_url }}" class="link">{{ section.settings.view_all_label }}</a>{%- endif -%}
  </div>
  {%- for block in section.blocks -%}
    <div class="grid grid--p{{ section.settings.columns }}" data-panel="{{ forloop.index0 }}" role="tabpanel"{% unless forloop.first %} hidden{% endunless %}>
      {%- assign c = block.settings.collection -%}
      {%- if c != blank and c.products_count > 0 -%}
        {%- for p in c.products limit: section.settings.limit -%}{% render 'product-card', card_product: p %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}{% render 'card-placeholder', n: i %}{%- endfor -%}
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Product tabs",
  "settings": [
    {
      "type": "range",
      "id": "limit",
      "label": "Products per tab",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Best sellers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
