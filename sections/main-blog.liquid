{%- paginate blog.articles by 12 -%}
<section class="page-w sec">
  <h1 class="h1">{{ blog.title }}</h1>
  <div class="blog">
    {%- for a in blog.articles -%}
      <a href="{{ a.url }}" class="blog__i">
        <span class="blog__img">{%- if a.image -%}{{ a.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: a.title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}</span>
        <span class="muted small">{{ a.published_at | date: '%B %d, %Y' }}</span><b>{{ a.title }}</b><span class="muted">{{ a.excerpt_or_content | strip_html | truncate: 140 }}</span>
      </a>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
