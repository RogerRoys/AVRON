<div class="page-w">
  <div class="trust" style="--n:{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <div class="trust__i" {{ block.shopify_attributes }}>
        {%- if block.settings.show_stars -%}<span class="trust__stars">★★★★★</span>{%- endif -%}
        <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Trust bar",
  "class": "section-trust",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tracked delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Updates at every stage"
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show stars",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
