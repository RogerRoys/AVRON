<div class="news">
  <div class="page-w news__in">
    <div><b class="news__h">{{ section.settings.heading }}</b><p class="muted">{{ section.settings.text }}</p></div>
    {%- form 'customer', class: 'news__form', id: 'Newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="news__ok">{% render 'icon', name: 'check' %} Thanks for subscribing.</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail">Email</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Email address" required autocomplete="email">
        <button type="submit" class="btn">Subscribe</button>
      {%- endif -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "Newsletter",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first to see what’s new"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "New collections, restocks and lighting guides, straight to your inbox."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
