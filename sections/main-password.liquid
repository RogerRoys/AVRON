<section class="page-w narrow sec center">
  <div class="header__logo" style="margin:0 auto 24px">{% render 'logo' %}</div>
  <h1 class="h1">Opening soon</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'news__form', style: 'margin:24px auto;max-width:460px' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}<p class="news__ok">Thanks — we'll email you when we open.</p>{%- else -%}<input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email"><button type="submit" class="btn">Notify me</button>{%- endif -%}
  {%- endform -%}
  <details class="acc" style="max-width:460px;margin:24px auto"><summary>Enter using password<i></i></summary><div class="acc__body">
    {%- form 'storefront_password', class: 'news__form' -%}<input type="password" name="password" placeholder="Password" aria-label="Password"><button type="submit" class="btn">Enter</button>{%- if form.errors -%}<p class="form-error">Incorrect password</p>{%- endif -%}{%- endform -%}
  </div></details>
</section>
{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
