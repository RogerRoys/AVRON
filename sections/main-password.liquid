<section class="xpw">
  <div class="xpw__l">
    <div class="xpw__logo">{% render 'logo' %}</div>
    <div class="xpw__c"><span class="xpg__eb">{{ section.settings.eyebrow }}</span><h1 class="xpg__h1">{{ section.settings.heading }}</h1><p class="xpg__lead">{%- if shop.password_message != blank -%}{{ shop.password_message }}{%- else -%}{{ section.settings.text }}{%- endif -%}</p>
      {%- form 'customer', class: 'xpw__form' -%}<input type="hidden" name="contact[tags]" value="prospect,password page">{%- if form.posted_successfully? -%}<p class="xct__ok">Thanks — we’ll let you know when we open.</p>{%- else -%}<input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email"><button type="submit">Notify me</button>{%- endif -%}{%- endform -%}
      <span class="xct__note">We’ll only use your email to tell you about the launch.</span></div>
    <div class="xpw__f"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span><button type="button" class="xpw__open" data-open="PwModal">🔒︎ Enter using password</button></div>
  </div>
  <div class="xpw__img">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1600 | image_tag: alt: '' }}{%- else -%}{% render 'demo-img', src: 'av-03.jpg', loading: 'eager' %}{%- endif -%}</div>
  <div class="modal" id="PwModal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enter store"><div class="drawer__overlay" data-close></div><div class="modal__panel xpw__m"><div class="xpw__mh"><b>Enter store</b><button type="button" class="xcd__x" data-close aria-label="Close">×</button></div><span class="xpg__lead" style="font-size:14px">Use the password to preview the store.</span>
    {%- form 'storefront_password', class: 'xpw__pf' -%}<input type="password" name="password" placeholder="Password" aria-label="Password"><button type="submit">Enter</button>{%- if form.errors -%}<p class="xct__err">Incorrect password</p>{%- endif -%}{%- endform -%}
    <a href="/admin" class="xct__note" style="text-align:center">Are you the store owner? Log in here.</a></div></div>
</section>
{% schema %}
{"name":"Password page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OPENING SOON"},{"type":"text","id":"heading","label":"Heading","default":"Avron is almost ready."},{"type":"textarea","id":"text","label":"Text","default":"An edited collection of lighting and ceiling fans for Australian homes. Leave your email and we’ll let you know when we open."},{"type":"image_picker","id":"image","label":"Image"}]}
{% endschema %}
