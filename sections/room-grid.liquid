<section class="page-w sec">
  {%- if section.settings.heading != blank -%}<div class="sec__head"><h2 class="h2">{{ section.settings.heading }}</h2></div>{%- endif -%}
  <div class="rooms">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="rooms__i" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.label }}{%- else -%}{%- assign rd = 'av-01.jpg,av-07.jpg,av-05.jpg,av-06.jpg' | split: ',' -%}{%- assign rk = forloop.index0 | modulo: 4 -%}{% render 'demo-img', src: rd[rk], alt: block.settings.label %}{%- endif -%}
        <span class="pill">{{ block.settings.label }} →</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Room grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by room"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Living room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Room grid",
      "blocks": [
        {
          "type": "room"
        },
        {
          "type": "room"
        },
        {
          "type": "room"
        },
        {
          "type": "room"
        }
      ]
    }
  ]
}
{% endschema %}
