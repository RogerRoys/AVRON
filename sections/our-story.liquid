<section class="xst" data-xrv="0">
  <div class="xst__media">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: section.settings.heading }}{%- else -%}{% render 'demo-img', src: 'av-04.jpg', alt: section.settings.heading %}{%- endif -%}</div>
  <div class="xst__txt">
    {%- if section.settings.eyebrow != blank -%}<span class="xst__eb">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="xst__h">{{ section.settings.heading }}</h2>
    <div class="xst__p">{{ section.settings.text }}</div>
    {%- if section.blocks.size > 0 -%}<div class="xst__pts">{%- for block in section.blocks -%}<div class="xst__pt" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>{%- endfor -%}</div>{%- endif -%}
    <div class="xst__btns">
      {%- if section.settings.btn1_label != blank -%}<a href="{{ section.settings.btn1_link | default: '#' }}" class="xst__b1">{{ section.settings.btn1_label }}</a>{%- endif -%}
      {%- if section.settings.btn2_label != blank -%}<a href="{{ section.settings.btn2_link | default: '#' }}" class="xst__b2">{{ section.settings.btn2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Our story","settings":[
 {"type":"image_picker","id":"image","label":"Image"},
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR STORY"},
 {"type":"text","id":"heading","label":"Heading","default":"Measured light for considered homes."},
 {"type":"richtext","id":"text","label":"Text","default":"<p>Avron makes thoughtfully designed lighting easier to understand, choose and live with. We keep the range edited, show every fitting at believable scale, and explain dimensions, installation and suitability in plain English, with dependable support before and after delivery.</p>"},
 {"type":"text","id":"btn1_label","label":"Button 1 label","default":"Read our story"},{"type":"url","id":"btn1_link","label":"Button 1 link"},
 {"type":"text","id":"btn2_label","label":"Button 2 label","default":"Visit the lighting guide"},{"type":"url","id":"btn2_link","label":"Button 2 link"}],
 "blocks":[{"type":"point","name":"Point","limit":4,"settings":[{"type":"text","id":"title","label":"Title","default":"An edited selection"},{"type":"text","id":"text","label":"Text","default":"Chosen for form, material, proportion and atmosphere."}]}],
 "presets":[{"name":"Our story","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]}
{% endschema %}
