<section class="xlg" data-xlg>
  <nav class="xpg__crumbs"><a href="{{ routes.root_url }}">Home</a>›<span>{{ page.title | default: 'Lighting guide' }}</span></nav>
  <div class="xlg__intro" data-xrv="0">
    <div class="xlg__introL"><span class="xlg__eb">{{ section.settings.eyebrow }}</span><h1 class="xlg__h1">{{ section.settings.heading }}</h1><div class="xlg__lead">{{ section.settings.intro }}</div></div>
    <div class="xlg__jumps"><a href="#lg-room-guide">Room guide</a><a href="#lg-warmth">Colour temperature</a><a href="#lg-size">Sizing</a><a href="#lg-outdoor">Outdoor &amp; IP</a><a href="#lg-bulbs">Before you buy</a></div>
  </div>
  {%- assign rooms = section.blocks | where: 'type', 'room' -%}
  {%- assign kels = section.blocks | where: 'type', 'kelvin' -%}
  {%- assign ips = section.blocks | where: 'type', 'ip' -%}
  {%- assign checks = section.blocks | where: 'type', 'check' -%}
  <div id="lg-room-guide" class="xlg__sec" data-xrv="0">
    <div class="xlg__head"><span class="xlg__eb">01 · ROOM GUIDE</span><h2 class="xlg__h2">{{ section.settings.room_heading }}</h2>
      <div class="xlg__tabs" role="tablist">{%- for b in rooms -%}<button type="button" class="xlg__tab{% if forloop.first %} is-on{% endif %}" data-lg-tab="{{ forloop.index0 }}" data-lux="{{ b.settings.lux }}" data-nl="{{ b.settings.name | downcase | escape }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ b.settings.name }}</button>{%- endfor -%}</div>
    </div>
    {%- for b in rooms -%}
    <div class="xlg__room{% if forloop.first %} is-on{% endif %}" data-lg-room="{{ forloop.index0 }}" {{ b.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
      <div class="xlg__roomImg">{%- if b.settings.image -%}{{ b.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: b.settings.name }}{%- elsif b.settings.demo_image != blank -%}<img src="{{ b.settings.demo_image }}" alt="{{ b.settings.name | escape }}" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}<span class="xlg__tag">{{ b.settings.name }} · {{ b.settings.kelvin }}</span></div>
      <div class="xlg__roomTxt">
        <div><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>
        <div class="xlg__layers">{%- for n in (1..3) -%}{%- assign ln = 'layer' | append: n | append: '_name' -%}{%- assign lt = 'layer' | append: n | append: '_text' -%}{%- if b.settings[ln] != blank -%}<div class="xlg__layer"><span>0{{ n }}</span><b>{{ b.settings[ln] }}</b><em>{{ b.settings[lt] }}</em></div>{%- endif -%}{%- endfor -%}</div>
        <div class="xlg__stats"><div><span>SUGGESTED WARMTH</span><b>{{ b.settings.kelvin }}</b><em>{{ b.settings.kelvin_note }}</em></div><div><span>BRIGHTNESS GUIDE</span><b>~{{ b.settings.lux }} lux</b><em>About {{ b.settings.lux }} lumens per m²</em></div></div>
        {%- if b.settings.tip != blank -%}<div class="xlg__tip"><b>Tip</b><span>{{ b.settings.tip }}</span></div>{%- endif -%}
        {%- if b.settings.btn_label != blank -%}<a href="{{ b.settings.btn_link | default: routes.all_products_collection_url }}" class="xlg__btn">{{ b.settings.btn_label }} →</a>{%- endif -%}
      </div>
    </div>
    {%- endfor -%}
  </div>
  <div id="lg-warmth" class="xlg__sec xlg__warm" data-xrv="0">
    <div class="xlg__warmL"><span class="xlg__eb">02 · COLOUR TEMPERATURE</span><h2 class="xlg__h2">{{ section.settings.warm_heading }}</h2><div class="xlg__lead">{{ section.settings.warm_text }}</div>
      <div class="xlg__kels">{%- for b in kels -%}<button type="button" class="xlg__kel{% if forloop.first %} is-on{% endif %}" data-lg-kel data-tint="{{ b.settings.tint }}" data-op="{{ b.settings.strength | divided_by: 100.0 }}" data-label="{{ b.settings.kelvin | escape }} {{ b.settings.name | escape }}" {{ b.shopify_attributes }}><span class="xlg__dot" style="background:radial-gradient(circle,{{ b.settings.glow }},{{ b.settings.tint }})"></span><span class="xlg__kelT"><b>{{ b.settings.kelvin }} · {{ b.settings.name }}</b><em>{{ b.settings.use }}</em></span><i></i></button>{%- endfor -%}</div>
    </div>
    {%- assign k0 = kels | first -%}
    <div class="xlg__warmImg">{%- if section.settings.warm_image -%}{{ section.settings.warm_image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: '' }}{%- else -%}<img src="https://heitz.shop/cdn/shop/files/heitz-home-our-promise-travertine-lamp.webp?width=1400" alt="" loading="lazy">{%- endif -%}<span class="xlg__tint" data-lg-tint style="background:{{ k0.settings.tint }};opacity:{{ k0.settings.strength | divided_by: 100.0 }}"></span><span class="xlg__tag" data-lg-tag>Preview: {{ k0.settings.kelvin }} {{ k0.settings.name }}</span></div>
  </div>
  <div id="lg-size" class="xlg__sec" data-xrv="0" data-lg-calc>
    <div class="xlg__head"><span class="xlg__eb">03 · SIZING</span><h2 class="xlg__h2">{{ section.settings.size_heading }}</h2><div class="xlg__lead">{{ section.settings.size_text }}</div></div>
    <div class="xlg__size">
      <div class="xlg__calc">
        <div class="xlg__dim"><span>Room length</span><div class="xlg__step"><button type="button" data-lg-dim="l" data-d="-0.5" aria-label="Decrease length">−</button><b><span data-lg-v="l">4</span> m</b><button type="button" data-lg-dim="l" data-d="0.5" aria-label="Increase length">+</button></div></div>
        <div class="xlg__dim"><span>Room width</span><div class="xlg__step"><button type="button" data-lg-dim="w" data-d="-0.5" aria-label="Decrease width">−</button><b><span data-lg-v="w">5</span> m</b><button type="button" data-lg-dim="w" data-d="0.5" aria-label="Increase width">+</button></div></div>
        <div class="xlg__area"><span>Room area</span><b><span data-lg-area>20</span> m²</b></div>
        <p>Rule of thumb: add the room’s length and width in metres, then multiply by 8 for a suggested fitting diameter in centimetres.</p>
      </div>
      <div class="xlg__res">
        <div><span>CEILING FITTING</span><b>~<i data-lg-diam>72</i> cm</b><em>Suggested diameter for a central pendant or ceiling light.</em></div>
        <div><span>TOTAL BRIGHTNESS</span><b>~<i data-lg-lm>3,000</i> lm</b><em>For a <i data-lg-nl>living room</i>, across all fittings.</em></div>
        <div><span>OVER A TABLE OR BENCH</span><b>75–90 cm</b><em>Hang height above the surface. Choose a fitting about half to two-thirds of the table’s width.</em></div>
      </div>
    </div>
  </div>
  <div id="lg-outdoor" class="xlg__sec xlg__ipw" data-xrv="0">
    <div><span class="xlg__eb">04 · OUTDOOR &amp; IP RATINGS</span><h2 class="xlg__h2">{{ section.settings.ip_heading }}</h2><div class="xlg__lead">{{ section.settings.ip_text }}</div></div>
    <div class="xlg__ip">{%- for b in ips -%}<div class="xlg__ipR" {{ b.shopify_attributes }}><b>{{ b.settings.rating }}</b><span><strong>{{ b.settings.meaning }}</strong><em>{{ b.settings.use }}</em></span></div>{%- endfor -%}</div>
  </div>
  <div id="lg-bulbs" class="xlg__sec" data-xrv="0">
    <div class="xlg__head"><span class="xlg__eb">05 · BULBS, DIMMING &amp; INSTALLATION</span><h2 class="xlg__h2">{{ section.settings.check_heading }}</h2></div>
    <div class="xlg__checks">{%- for b in checks -%}<div class="xlg__check" {{ b.shopify_attributes }}><b>{{ b.settings.title }}</b><span>{{ b.settings.text }}</span></div>{%- endfor -%}</div>
  </div>
  {%- if section.settings.cta_heading != blank -%}
  <div class="xlg__cta" data-xrv="0"><div><b>{{ section.settings.cta_heading }}</b><span>{{ section.settings.cta_text }}</span></div><div class="xlg__ctaB"><a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="xlg__ctaP">{{ section.settings.cta_btn }}</a><a href="{{ section.settings.cta2_link | default: '/pages/faq' }}" class="xlg__ctaS">{{ section.settings.cta2_btn }}</a></div></div>
  {%- endif -%}
</section>
{% schema %}
{
