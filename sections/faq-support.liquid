<section class="xfaq">
  <div class="xfaq__col" data-xrv="0">
    <h2 class="xfaq__h">{{ section.settings.heading }}</h2>
    {%- for block in section.blocks -%}
      <div class="xfaq__i{% if forloop.first %} is-open{% endif %}" data-xfaq {{ block.shopify_attributes }}>
        <button type="button" class="xfaq__q" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"><span>{{ block.settings.question }}</span><span class="xfaq__ic" aria-hidden="true">+</span></button>
        <div class="xfaq__a"><div><div class="xfaq__p">{{ block.settings.answer }}</div></div></div>
      </div>
    {%- endfor -%}
  </div>
  <div class="xfaq__side">
    {%- if section.settings.w_title != blank -%}
      <div class="xfaq__card" data-xrv="80"><b>{{ section.settings.w_title }}</b><span>{{ section.settings.w_text }}</span>{%- if section.settings.w_link_label != blank -%}<a href="{{ section.settings.w_link | default: '#' }}" class="xfaq__lnk">{{ section.settings.w_link_label }}</a>{%- endif -%}</div>
    {%- endif -%}
    {%- if section.settings.t_title != blank -%}
      <div class="xfaq__card xfaq__card--brand" data-xrv="160"><b>{{ section.settings.t_title }}</b><span>{{ section.settings.t_text }}</span>{%- if section.settings.t_btn != blank -%}<a href="{{ section.settings.t_link | default: '#' }}" class="xfaq__btn">{{ section.settings.t_btn }}</a>{%- endif -%}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ & support",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "header",
      "content": "Warranty card"
    },
    {
      "type": "text",
      "id": "w_title",
      "label": "Title",
      "default": "1-year voluntary warranty"
    },
    {
      "type": "textarea",
      "id": "w_text",
      "label": "Text",
      "default": "Electrical, wiring and LED faults covered. Repair, replace or refund."
    },
    {
      "type": "text",
      "id": "w_link_label",
      "label": "Link label",
      "default": "Warranty details"
    },
    {
      "type": "url",
      "id": "w_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Trade card"
    },
    {
      "type": "text",
      "id": "t_title",
      "label": "Title",
      "default": "Avron Trade"
    },
    {
      "type": "textarea",
      "id": "t_text",
      "label": "Text",
      "default": "Project pricing for designers, builders and stylists."
    },
    {
      "type": "text",
      "id": "t_btn",
      "label": "Button label",
      "default": "Apply now"
    },
    {
      "type": "url",
      "id": "t_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Tracked delivery to US, UK, AU and EU.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ & support",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
