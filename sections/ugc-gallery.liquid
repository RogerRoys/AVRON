<section class="page-w sec">
  <div class="sec__head"><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<span class="muted">{{ section.settings.text }}</span>{%- endif -%}</div>
  <div class="ugc">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" class="ugc__i" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 500 | image_tag: widths: '250,500', sizes: '(min-width: 990px) 16vw, 33vw', loading: 'lazy', alt: '' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        <span class="ugc__ov">{{ section.settings.overlay }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "UGC gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "#AvronAtHome"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Tag us on Instagram to be featured"
    },
    {
      "type": "text",
      "id": "overlay",
      "label": "Hover label",
      "default": "Shop the look"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
