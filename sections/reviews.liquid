<section class="page-w sec" id="reviews">
  <div class="sec__head">
    <div><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}</div>
  </div>
  {%- assign manual = section.blocks | where: 'type', 'review' -%}
  {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
  {%- if manual.size > 0 -%}
    <div class="revs">
      {%- for block in manual -%}
        <div class="rev" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}<span class="rev__img">{{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
          <div class="rev__b"><span class="rev__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</span><p>{{ block.settings.text }}</p><span class="muted small">{{ block.settings.author }} · Verified buyer</span></div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "Looks even better in person."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah, UK"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
