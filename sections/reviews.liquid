<section class="page-w sec" id="reviews">
  {%- assign manual = section.blocks | where: 'type', 'review' -%}
  <div class="sec__head">
    <div><h2 class="h2">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}</div>
    {%- if manual.size > 3 -%}<div class="revs__nav"><button type="button" class="round-btn" data-rev-prev aria-label="Previous reviews">{% render 'icon', name: 'arrow-left' %}</button><button type="button" class="round-btn round-btn--solid" data-rev-next aria-label="Next reviews">{% render 'icon', name: 'arrow-right' %}</button></div>{%- endif -%}
  </div>
  {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
  {%- if manual.size > 0 -%}
    <div class="revs-wrap">
      <div class="revs" data-revs>
        {%- for block in manual -%}
          <div class="rev" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}<span class="rev__img">{{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</span>{%- elsif section.settings.demo_images -%}{%- assign vd = 'av-08.jpg,av-09.jpg,av-05.jpg,av-10.jpg,av-11.jpg' | split: ',' -%}{%- assign vk = forloop.index0 | modulo: 5 -%}<span class="rev__img">{% render 'demo-img', src: vd[vk] %}</span>{%- endif -%}
            <div class="rev__b"><span class="rev__stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</span><p>{{ block.settings.text }}</p><span class="muted small">{{ block.settings.author }} · Verified buyer</span></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    {"type":"checkbox","id":"demo_images","label":"Show demo photos on reviews","default":true},
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "Looks even better in person."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah, UK"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
