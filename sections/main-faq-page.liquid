<section class="xpg">
  <nav class="xpg__crumbs"><a href="{{ routes.root_url }}">Home</a>›<span>{{ page.title | default: 'FAQ' }}</span></nav>
  <div class="xpg__intro" data-xrv="0"><span class="xpg__eb">{{ section.settings.eyebrow }}</span><h1 class="xpg__h1">{{ section.settings.heading }}</h1><div class="xpg__lead">{{ section.settings.intro }}</div></div>
  {%- assign groups = '' -%}{%- for b in section.blocks -%}{%- unless groups contains b.settings.group -%}{%- assign groups = groups | append: b.settings.group | append: '|' -%}{%- endunless -%}{%- endfor -%}{%- assign gl = groups | split: '|' -%}
  <div class="xfp__chips">{%- for g in gl -%}<a href="#faq-{{ forloop.index }}" class="xfp__chip{% if forloop.first %} is-on{% endif %}">{{ g }}</a>{%- endfor -%}</div>
  <div class="xfp">
    <aside class="xfp__side"><div class="xfp__nav">{%- for g in gl -%}<a href="#faq-{{ forloop.index }}">{{ g }}<span>›</span></a>{%- endfor -%}</div><div class="xfp__cta"><b>{{ section.settings.cta_heading }}</b><span>{{ section.settings.cta_text }}</span><a href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_btn }}</a></div></aside>
    <div class="xfp__main">{%- for g in gl -%}<div class="xfp__grp" id="faq-{{ forloop.index }}" data-xrv="0"><h2>{{ g }}</h2>{%- assign gi = forloop.index -%}{%- for b in section.blocks -%}{%- if b.settings.group == g -%}<div class="xfaq__i{% if gi == 1 and forloop.first %} is-open{% endif %}" data-xfaq {{ b.shopify_attributes }}><button type="button" class="xfaq__q"><span>{{ b.settings.question }}</span><span class="xfaq__ic" aria-hidden="true">+</span></button><div class="xfaq__a"><div><div class="xfaq__p">{{ b.settings.answer }}</div></div></div></div>{%- endif -%}{%- endfor -%}</div>{%- endfor -%}</div>
  </div>
</section>
{% schema %}
{"name":"FAQ page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HELP & FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Questions, answered clearly."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Guidance on choosing, installing and receiving your lighting. If something isn’t covered here, we’re happy to help.</p>"},{"type":"text","id":"cta_heading","label":"Help card heading","default":"Still have a question?"},{"type":"text","id":"cta_text","label":"Help card text","default":"Ask us about sizing, finishes or installation before you choose."},{"type":"text","id":"cta_btn","label":"Help card button","default":"Contact us"},{"type":"url","id":"cta_link","label":"Help card link"}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"group","label":"Category","default":"Choosing lighting"},{"type":"text","id":"question","label":"Question","default":"Question"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Answer</p>"}]}]}
{% endschema %}
