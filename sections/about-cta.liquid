<div class="xab-s" style="--s-bg:{{ section.settings.bg | default: 'transparent' }};--s-pt:{{ section.settings.pt }}px;--s-pb:{{ section.settings.pb }}px">
<section class="xpg">
  <div class="xab__cta" data-xrv="0"><div><b>{{ section.settings.heading }}</b>{%- if section.settings.text != blank -%}<span>{{ section.settings.text }}</span>{%- endif -%}</div><div class="xab__btns">{%- for b in section.blocks -%}<a href="{{ b.settings.link | default: routes.all_products_collection_url }}" class="{% if b.settings.style == 'outline' %}xab__b2{% else %}xab__b1{% endif %}" {{ b.shopify_attributes }}>{{ b.settings.label }}</a>{%- endfor -%}</div></div>
</section>
</div>
{% schema %}
{
  "name": "CTA banner",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right fitting for your space."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Explore the collection, or ask us before you choose."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Explore lighting"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA banner",
      "blocks": [
        {
          "type": "button"
        },
        {
          "type": "button",
          "settings": {
            "label": "Contact us",
            "style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}
