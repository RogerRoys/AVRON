<div class="xlg-s" data-xlg-part style="--s-bg:{{ section.settings.bg | default: 'transparent' }};--s-pt:{{ section.settings.pt }}px;--s-pb:{{ section.settings.pb }}px">
<section class="xlg xlg--part">
  {%- if section.settings.crumbs -%}<nav class="xpg__crumbs"><a href="{{ routes.root_url }}">Home</a>›<span>{{ page.title | default: 'Lighting guide' }}</span></nav>{%- endif -%}
  <div class="xlg__intro" data-xrv="0">
    <div class="xlg__introL"><span class="xlg__eb">{{ section.settings.eyebrow }}</span><h1 class="xlg__h1">{{ section.settings.heading }}</h1><div class="xlg__lead">{{ section.settings.intro }}</div></div>
    {%- if section.blocks.size > 0 -%}<div class="xlg__jumps">{%- for b in section.blocks -%}<a href="#{{ b.settings.anchor }}" {{ b.shopify_attributes }}>{{ b.settings.label }}</a>{%- endfor -%}</div>{%- endif -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "Guide intro",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "crumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LIGHTING GUIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choosing light, made clear."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>A practical guide to planning light room by room: which warmth to choose, what size suits your space, and what to check before you buy.</p>"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "jump",
      "name": "Jump link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Room guide"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Section ID",
          "default": "lg-room-guide",
          "info": "Matches the \"Jump-link ID\" of the section to scroll to."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide intro"
    }
  ]
}
{% endschema %}
