{%- if section.blocks.size > 0 -%}
<div class="announce" style="--ab-bg:{{ section.settings.bg }};--ab-fg:{{ section.settings.fg }}" data-rotate data-speed="{{ section.settings.speed }}">
  {%- for block in section.blocks -%}
    <div class="announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<p>{{ block.settings.text }}</p>{%- endif -%}
    </div>
  {%- endfor -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#2F4A3A"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per message",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Tracked delivery with updates at every stage"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
