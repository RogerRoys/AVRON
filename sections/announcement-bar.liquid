{%- if section.blocks.size > 0 -%}
<div class="announce{% if section.settings.arrows and section.blocks.size > 1 %} announce--arrows{% endif %}{% if section.settings.show_currency and localization.available_countries.size > 1 %} announce--cc{% endif %}" style="--ab-bg:{{ section.settings.bg }};--ab-fg:{{ section.settings.fg }}" data-rotate data-speed="{{ section.settings.speed }}">
  {%- if section.settings.arrows and section.blocks.size > 1 -%}<button type="button" class="announce__arw announce__arw--prev" data-ann-prev aria-label="Previous message"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>{%- endif -%}
  <div class="announce__track">
  {%- for block in section.blocks -%}
    <div class="announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {%- liquid
        assign t = block.settings.text
        assign tp = t | split: ' · Prices'
        if tp.size > 1
          assign t = tp[0] | append: '<span class="ann-hide-sm"> · Prices' | append: tp[1] | append: '</span>'
        endif
      -%}
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ t }}</a>{%- else -%}<p>{{ t }}</p>{%- endif -%}
    </div>
  {%- endfor -%}
  </div>
  {%- if section.settings.arrows and section.blocks.size > 1 -%}<button type="button" class="announce__arw announce__arw--next" data-ann-next aria-label="Next message"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>{%- endif -%}
  {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
  <div class="ann-cc" data-ann-cc>
    {%- form 'localization', class: 'ann-cc__form' -%}
      <input type="hidden" name="return_to" value="{{ request.path }}">
      <button type="button" class="ann-cc__btn" data-cc-toggle aria-expanded="false" aria-label="Country / currency: {{ localization.country.name | escape }}"><img src="https://flagcdn.com/w80/{{ localization.country.iso_code | downcase }}.png" alt="" width="18" height="18" loading="lazy"><span>{{ localization.country.currency.iso_code }}</span><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
      <div class="ann-cc__menu" role="listbox" aria-label="Country / currency">
        <b class="ann-cc__h">{{ section.settings.currency_heading }}</b>
        {%- for c in localization.available_countries -%}
          <button type="submit" name="country_code" value="{{ c.iso_code }}" class="ann-cc__opt{% if c.iso_code == localization.country.iso_code %} is-on{% endif %}" role="option" aria-selected="{% if c.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}"><img src="https://flagcdn.com/w80/{{ c.iso_code | downcase }}.png" alt="" width="22" height="22" loading="lazy"><span>{{ c.name }}</span><em>{{ c.currency.iso_code }} {{ c.currency.symbol }}</em></button>
        {%- endfor -%}
      </div>
    {%- endform -%}
  </div>
  {%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#2F4A3A"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per message",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Country / currency selector"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show country / currency selector",
      "default": true,
      "info": "Lists the countries enabled in Settings → Markets. Shows only when 2 or more are available."
    },
    {
      "type": "text",
      "id": "currency_heading",
      "label": "Dropdown heading",
      "default": "Country / currency"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Tracked delivery with updates at every stage"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
