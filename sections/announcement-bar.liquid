{%- if section.settings.text != blank -%}
<div class="announce" style="--ab-bg:{{ section.settings.bg }};--ab-fg:{{ section.settings.fg }}">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}<p>{{ section.settings.text }}</p>{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Free tracked shipping on every order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#2F4A3A"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
