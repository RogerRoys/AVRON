<section class="page-w sec">
  <div class="mg">
    <div class="mg__card mg__card--soft">
      <h2 class="h2">{{ section.settings.heading_left }}</h2>
      <div class="mg__mats">
        {%- for block in section.blocks -%}{%- if block.type == 'material' -%}
          <div class="mg__mat" {{ block.shopify_attributes }}><span class="mg__sw" style="background:{{ block.settings.swatch }}"></span><span><b>{{ block.settings.name }}</b><em>{{ block.settings.text }}</em></span>{%- if block.settings.use != blank -%}<i class="mg__use">{{ block.settings.use }}</i>{%- endif -%}</div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
    <div class="mg__card mg__card--dark" data-kelvin>
      <h2 class="h2">{{ section.settings.heading_right }}</h2>
      {%- assign kels = section.blocks | where: 'type', 'kelvin' -%}
      {%- assign k0 = kels[1] | default: kels[0] -%}
      <div class="mg__preview">
        {%- if section.settings.preview_image -%}{{ section.settings.preview_image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: '' }}{%- else -%}{% render 'demo-img', src: 'av-01.jpg' %}{%- endif -%}
        <span class="mg__tint" data-kel-tint style="background-color:{{ k0.settings.glow }}"></span>
        <span class="mg__glowspot"></span>
        <span class="mg__tag" data-kel-tag>{{ k0.settings.label }} · {{ k0.settings.text }}</span>
      </div>
      <div class="mg__kel">
        {%- for block in kels -%}
          <button type="button" class="mg__k" data-kel data-glow="{{ block.settings.glow }}" data-label="{{ block.settings.label | escape }} · {{ block.settings.text | escape }}" aria-pressed="{% if block.id == k0.id %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}><span class="glow" style="--glow:{{ block.settings.glow }}"></span><b>{{ block.settings.label }}</b><em>{{ block.settings.text }}</em></button>
        {%- endfor -%}
      </div>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--white">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Materials & guide",
  "settings": [
    {
      "type": "text",
      "id": "heading_left",
      "label": "Left heading",
      "default": "Made from materials that last"
    },
    {
      "type": "text",
      "id": "heading_right",
      "label": "Right heading",
      "default": "Not sure which warmth?"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Warmth preview image",
      "info": "A room photo — it gets tinted with the selected colour temperature."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Open the lighting guide"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material",
      "settings": [
        {
          "type": "color",
          "id": "swatch",
          "label": "Swatch",
          "default": "#D6C6AC"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Travertine"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Natural, veined stone"
        },
        {
          "type": "text",
          "id": "use",
          "label": "Used for",
          "info": "Small pill on the right, e.g. Table lamps"
        }
      ]
    },
    {
      "type": "kelvin",
      "name": "Colour temperature",
      "settings": [
        {
          "type": "color",
          "id": "glow",
          "label": "Glow colour",
          "default": "#FFCF8A"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "2700K"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Living, dining"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Materials & guide",
      "blocks": [
        {
          "type": "material"
        },
        {
          "type": "material"
        },
        {
          "type": "kelvin"
        },
        {
          "type": "kelvin"
        }
      ]
    }
  ]
}
{% endschema %}
