<section class="xpg">
  <nav class="xpg__crumbs"><a href="{{ routes.root_url }}">Home</a>›<span>{{ page.title | default: 'About' }}</span></nav>
  <div class="xab__hero" data-xrv="0"><div class="xab__ht"><span class="xpg__eb">{{ section.settings.eyebrow }}</span><h1 class="xpg__h1">{{ section.settings.heading }}</h1><div class="xpg__lead">{{ section.settings.intro }}</div></div><div class="xab__img">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: '' }}{%- else -%}{% render 'demo-img', src: 'av-04.jpg' %}{%- endif -%}</div></div>
  <div class="xab__two" data-xrv="0"><div><span class="xpg__eb">{{ section.settings.p_eyebrow }}</span><h2 class="xpg__h2">{{ section.settings.p_heading }}</h2></div><div class="xpg__body">{{ section.settings.p_text }}</div></div>
  <div class="xab__pl"><h2 class="xpg__h2" data-xrv="0">{{ section.settings.pillars_heading }}</h2><div class="xab__cards">{%- assign n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'pillar' -%}{%- assign n = n | plus: 1 -%}<div class="xab__card" data-xrv="{{ forloop.index0 | times: 80 }}" {{ b.shopify_attributes }}><span>0{{ n }}</span><b>{{ b.settings.title }}</b><p>{{ b.settings.text }}</p></div>{%- endif -%}{%- endfor -%}</div></div>
  <div class="xab__diff"><div class="xab__dimg" data-xrv="0">{%- if section.settings.image2 -%}{{ section.settings.image2 | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'demo-img', src: 'av-01.jpg' %}{%- endif -%}</div><div data-xrv="80"><span class="xpg__eb">{{ section.settings.d_eyebrow }}</span><h2 class="xpg__h2">{{ section.settings.d_heading }}</h2><div class="xab__list">{%- for b in section.blocks -%}{%- if b.type == 'point' -%}<div {{ b.shopify_attributes }}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F9E5B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M7.8 12.3l2.8 2.8 5.6-5.8"/></svg><span>{{ b.settings.text }}</span></div>{%- endif -%}{%- endfor -%}</div></div></div>
  <div class="xab__cta" data-xrv="0"><div><b>{{ section.settings.cta_heading }}</b><span>{{ section.settings.cta_text }}</span></div><div class="xab__btns"><a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="xab__b1">{{ section.settings.cta1 }}</a><a href="{{ section.settings.cta2_link | default: '/pages/contact' }}" class="xab__b2">{{ section.settings.cta2 }}</a></div></div>
</section>
{% schema %}
{"name":"About page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ABOUT AVRON"},{"type":"text","id":"heading","label":"Heading","default":"Considered lighting, made clear."},{"type":"richtext","id":"intro","label":"Intro","default":"<p>Avron is a curated online destination for lighting and ceiling fans. We exist to make thoughtfully designed lighting easier to understand, choose and live with in Australian homes.</p>"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"p_eyebrow","label":"Purpose eyebrow","default":"OUR PURPOSE"},{"type":"text","id":"p_heading","label":"Purpose heading","default":"Lighting that adds architectural character, warmth and atmosphere."},{"type":"richtext","id":"p_text","label":"Purpose text","default":"<p>Good lighting shapes how a home feels, yet choosing it can feel technical and overwhelming. We keep our range edited, present every fitting at believable scale, and explain dimensions, installation and suitability in plain English.</p><p>Our aim is to become a trusted Australian online destination for lighting — one that makes the buying process feel calm and clear, and stands behind every order with dependable support.</p>"},{"type":"text","id":"pillars_heading","label":"Pillars heading","default":"What guides us"},{"type":"image_picker","id":"image2","label":"Second image"},{"type":"text","id":"d_eyebrow","label":"Points eyebrow","default":"WHAT MAKES AVRON DIFFERENT"},{"type":"text","id":"d_heading","label":"Points heading","default":"An edited range, with confidence at every stage."},{"type":"text","id":"cta_heading","label":"CTA heading","default":"Find the right fitting for your space."},{"type":"text","id":"cta_text","label":"CTA text","default":"Explore the collection, or ask us before you choose."},{"type":"text","id":"cta1","label":"Button 1","default":"Explore lighting"},{"type":"url","id":"cta1_link","label":"Button 1 link"},{"type":"text","id":"cta2","label":"Button 2","default":"Contact us"},{"type":"url","id":"cta2_link","label":"Button 2 link"}],"blocks":[{"type":"pillar","name":"Pillar","settings":[{"type":"text","id":"title","label":"Title","default":"Considered design"},{"type":"textarea","id":"text","label":"Text","default":"An edited collection chosen for form, material, proportion and atmosphere."}]},{"type":"point","name":"Point","settings":[{"type":"text","id":"text","label":"Text","default":"A focused and coherent selection rather than an overwhelming catalogue."}]}]}
{% endschema %}
