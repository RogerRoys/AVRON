<div class="xlg-s" data-xlg-part style="--s-bg:{{ section.settings.bg | default: 'transparent' }};--s-pt:{{ section.settings.pt }}px;--s-pb:{{ section.settings.pb }}px">
<section class="xlg xlg--part">
  <div id="{{ section.settings.anchor }}" class="xlg__sec" data-xrv="0" data-lg-calc>
    <div class="xlg__head"><span class="xlg__eb">{{ section.settings.eyebrow }}</span><h2 class="xlg__h2">{{ section.settings.size_heading }}</h2><div class="xlg__lead">{{ section.settings.size_text }}</div></div>
    <div class="xlg__size">
      <div class="xlg__calc">
        <div class="xlg__dim"><span>Room length</span><div class="xlg__step"><button type="button" data-lg-dim="l" data-d="-0.5" aria-label="Decrease length">−</button><b><span data-lg-v="l">4</span> m</b><button type="button" data-lg-dim="l" data-d="0.5" aria-label="Increase length">+</button></div></div>
        <div class="xlg__dim"><span>Room width</span><div class="xlg__step"><button type="button" data-lg-dim="w" data-d="-0.5" aria-label="Decrease width">−</button><b><span data-lg-v="w">5</span> m</b><button type="button" data-lg-dim="w" data-d="0.5" aria-label="Increase width">+</button></div></div>
        <div class="xlg__area"><span>Room area</span><b><span data-lg-area>20</span> m²</b></div>
        {%- if section.settings.rule != blank -%}<p>{{ section.settings.rule }}</p>{%- endif -%}
      </div>
      <div class="xlg__res">
        <div><span>CEILING FITTING</span><b>~<i data-lg-diam>72</i> cm</b><em>Suggested diameter for a central pendant or ceiling light.</em></div>
        <div><span>TOTAL BRIGHTNESS</span><b>~<i data-lg-lm>3,000</i> lm</b><em>For a <i data-lg-nl>living room</i>, across all fittings.</em></div>
        {%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><span>{{ b.settings.label }}</span><b>{{ b.settings.value }}</b><em>{{ b.settings.text }}</em></div>{%- endfor -%}
      </div>
    </div>
  </div>
</section>
</div>
{% schema %}
{
  "name": "Sizing calculator",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Jump-link ID",
      "default": "lg-size",
      "info": "Used by the jump links in the Guide intro section (without #)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "03 · SIZING"
    },
    {
      "type": "text",
      "id": "size_heading",
      "label": "Heading",
      "default": "Find a size that suits the room"
    },
    {
      "type": "richtext",
      "id": "size_text",
      "label": "Text",
      "default": "<p>Enter your room size for a starting point. Always compare against the width and drop listed on each product page.</p>"
    },
    {
      "type": "textarea",
      "id": "rule",
      "label": "Rule of thumb",
      "default": "Rule of thumb: add the room’s length and width in metres, then multiply by 8 for a suggested fitting diameter in centimetres."
    },
    {
      "type": "paragraph",
      "content": "Ceiling fitting and total brightness are calculated automatically. Brightness uses the room selected in the Room guide tabs section."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Extra card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "OVER A TABLE OR BENCH"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "75–90 cm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Hang height above the surface. Choose a fitting about half to two-thirds of the table’s width."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sizing calculator",
      "blocks": [
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
