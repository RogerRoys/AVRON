<footer class="footer">
  <div class="page-w footer__grid">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="header__logo">{% render 'logo' %}</a>
      <p class="muted">{{ section.settings.text }}</p>
      <div class="footer__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
      </div>
    </div>
    {%- for i in (1..3) -%}
      {%- liquid
        assign km = 'menu_' | append: i
        assign kt = 'title_' | append: i
        assign m = linklists[section.settings[km]]
      -%}
      {%- if m.links.size > 0 -%}
        <div class="footer__col"><b>{{ section.settings[kt] | default: m.title }}</b>{%- for link in m.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="page-w footer__bar">
    <span class="muted small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- render 'localization', id: 'FooterLoc' -%}
    {%- if section.settings.show_payment -%}<ul class="pay">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand text",
      "default": "Indoor & outdoor lighting and décor. Shipping to US, UK, AU & EU."
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Column 1 title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Column 2 title",
      "default": "Customer care"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Column 3 title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
