<footer class="xft">
  <div class="xft__top">
    <div class="xft__brand">
      <a href="{{ routes.root_url }}" class="xft__logo">{% render 'logo' %}</a>
      <p>{{ section.settings.text }}</p>
      <b class="xft__fh">{{ section.settings.social_heading }}</b>
      <div class="xft__socs">
        {%- assign u = settings.social_instagram -%}{%- if u != blank or section.settings.demo_social -%}<a href="{{ u | default: '#' }}"{% if u != blank %} target="_blank" rel="noopener"{% endif %} class="xft__soc" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
        {%- assign u = settings.social_facebook -%}{%- if u != blank or section.settings.demo_social -%}<a href="{{ u | default: '#' }}"{% if u != blank %} target="_blank" rel="noopener"{% endif %} class="xft__soc" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v7h4v-7h3l.5-4h-3.5V9c0-.6.4-1 1-1z"/></svg></a>{%- endif -%}
        {%- assign u = settings.social_pinterest -%}{%- if u != blank or section.settings.demo_social -%}<a href="{{ u | default: '#' }}"{% if u != blank %} target="_blank" rel="noopener"{% endif %} class="xft__soc" aria-label="Pinterest"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-3.6 19.3c-.1-.8-.2-2 0-2.9l1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.7 2-2.7.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.4-2 3.4-5 0-2.6-1.9-4.4-4.5-4.4-3.1 0-4.9 2.3-4.9 4.7 0 .9.4 1.9.8 2.5.1.1.1.2.1.3l-.3 1.2c0 .2-.2.3-.4.2-1.4-.7-2.3-2.7-2.3-4.3 0-3.5 2.6-6.8 7.4-6.8 3.9 0 6.9 2.8 6.9 6.5 0 3.9-2.4 7-5.8 7-1.1 0-2.2-.6-2.6-1.3l-.7 2.7c-.3 1-.9 2.2-1.4 2.9A10 10 0 1012 2z"/></svg></a>{%- endif -%}
        {%- assign u = settings.social_tiktok -%}{%- if u != blank or section.settings.demo_social -%}<a href="{{ u | default: '#' }}"{% if u != blank %} target="_blank" rel="noopener"{% endif %} class="xft__soc" aria-label="Tiktok"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0115.5 3h-3.3v12.4a2.6 2.6 0 11-2.6-2.6c.3 0 .5 0 .8.1V9.5h-.8a5.9 5.9 0 105.9 5.9V9.1a7.6 7.6 0 004.4 1.4V7.2a4.3 4.3 0 01-3.3-1.4z"/></svg></a>{%- endif -%}
        {%- assign u = settings.social_youtube -%}{%- if u != blank or section.settings.demo_social -%}<a href="{{ u | default: '#' }}"{% if u != blank %} target="_blank" rel="noopener"{% endif %} class="xft__soc" aria-label="Youtube"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 002.4 7.2 26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15V9l5.2 3z"/></svg></a>{%- endif -%}
      </div>
    </div>
    {%- assign m = linklists[section.settings.menu_1] -%}
      <details class="xft__col xft__acc" open data-mclose><summary class="xft__ch">{{ section.settings.title_1 }}<span class="xft__pm" aria-hidden="true">+</span></summary><div class="xft__links">{%- if m.links.size > 0 -%}{%- for link in m.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}{%- else -%}<a href="{{ routes.search_url }}?q=Indoor%20lighting">Indoor lighting</a><a href="{{ routes.search_url }}?q=Outdoor%20lighting">Outdoor lighting</a><a href="{{ routes.search_url }}?q=Ceiling%20fans">Ceiling fans</a><a href="{{ routes.search_url }}?q=D%C3%A9cor">Décor</a><a href="{{ routes.search_url }}?q=Sale">Sale</a>{%- endif -%}</div></details>
    {%- assign m = linklists[section.settings.menu_2] -%}
      <details class="xft__col xft__acc" open data-mclose><summary class="xft__ch">{{ section.settings.title_2 }}<span class="xft__pm" aria-hidden="true">+</span></summary><div class="xft__links">{%- if m.links.size > 0 -%}{%- for link in m.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}{%- else -%}<a href="/pages/track-order">Track order</a><a href="{{ routes.root_url }}policies/shipping-policy">Shipping</a><a href="{{ routes.root_url }}policies/refund-policy">Returns</a><a href="/pages/warranty">Warranty</a><a href="/pages/faq">FAQ</a>{%- endif -%}</div></details>
    <div class="xft__col xft__contact">
      <b class="xft__ch">{{ section.settings.contact_heading }}</b>
      <div class="xft__ci">
        {%- if section.settings.c_name != blank -%}<span><b>Business Name:</b> {{ section.settings.c_name }}</span>{%- endif -%}
        {%- if section.settings.c_address != blank -%}<span><b>Business Address:</b> {{ section.settings.c_address }}</span>{%- endif -%}
        {%- if section.settings.c_email != blank -%}<span><b>Email:</b> <a href="mailto:{{ section.settings.c_email }}">{{ section.settings.c_email }}</a></span>{%- endif -%}
        {%- if section.settings.c_phone != blank -%}<span><b>Phone:</b> <a href="tel:{{ section.settings.c_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.c_phone }}</a></span>{%- endif -%}
        {%- if section.settings.c_hours != blank -%}<span><b>Opening hours:</b> {{ section.settings.c_hours }}</span>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="xft__bar">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</span>
    <div class="xft__legal">{%- for p in shop.policies -%}{%- if p.title contains 'Privacy' or p.title contains 'Terms' or p.title contains 'Refund' -%}<a href="{{ p.url }}">{{ p.title }}</a>{%- endif -%}{%- else -%}<a href="{{ routes.root_url }}policies/privacy-policy">Privacy policy</a><a href="{{ routes.root_url }}policies/terms-of-service">Terms of service</a><a href="{{ routes.root_url }}policies/refund-policy">Refund policy</a>{%- endfor -%}</div>
    {%- if section.settings.show_payment -%}<ul class="xft__pay">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}
  </div>
</footer>
{% schema %}
{"name":"Footer","enabled_on":{"groups":["footer"]},"settings":[
 {"type":"textarea","id":"text","label":"Brand text","default":"Indoor & outdoor lighting and décor. Free tracked shipping to the US, UK, Australia & EU."},
 {"type":"text","id":"social_heading","label":"Social heading","default":"Follow us"},
 {"type":"checkbox","id":"demo_social","label":"Show all social icons even without links (demo)","default":true},
 {"type":"text","id":"title_1","label":"Column 1 title","default":"Shop"},{"type":"link_list","id":"menu_1","label":"Column 1 menu"},
 {"type":"text","id":"title_2","label":"Column 2 title","default":"Customer care"},{"type":"link_list","id":"menu_2","label":"Column 2 menu"},
 {"type":"header","content":"Contact information"},
 {"type":"text","id":"contact_heading","label":"Heading","default":"Contact information"},
 {"type":"text","id":"c_name","label":"Business name","default":"Avron Home LLC"},
 {"type":"text","id":"c_address","label":"Business address","default":"1209 Orange St, Wilmington, DE 19801, USA"},
 {"type":"text","id":"c_email","label":"Email","default":"support@avron.shop"},
 {"type":"text","id":"c_phone","label":"Phone","default":"+1 (555) 012-3456"},
 {"type":"text","id":"c_hours","label":"Opening hours","default":"Monday to Friday, 09:00–17:00 (EST) · Response time: 12–24 hours"},
 {"type":"header","content":"Bottom bar"},
 {"type":"text","id":"copyright","label":"Copyright name","default":"Avron Home LLC"},
 {"type":"checkbox","id":"show_payment","label":"Show payment icons","default":true}]}
{% endschema %}
