<div class="xab-s" style="--s-bg:{{ section.settings.bg | default: 'transparent' }};--s-pt:{{ section.settings.pt }}px;--s-pb:{{ section.settings.pb }}px">
<section class="xpg">
  <div class="xab__diff{% if section.settings.flip %} xab__diff--flip{% endif %}"><div class="xab__dimg" data-xrv="0">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'demo-img', src: 'av-01.jpg' %}{%- endif -%}</div><div data-xrv="80"><span class="xpg__eb">{{ section.settings.eyebrow }}</span><h2 class="xpg__h2">{{ section.settings.heading }}</h2><div class="xab__list">{%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F9E5B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M7.8 12.3l2.8 2.8 5.6-5.8"/></svg><span>{{ b.settings.text }}</span></div>{%- endfor -%}</div></div></div>
</section>
</div>
{% schema %}
{
  "name": "Image with checklist",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT MAKES AVRON DIFFERENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An edited range, with confidence at every stage."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "A focused and coherent selection rather than an overwhelming catalogue."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with checklist",
      "blocks": [
        {
          "type": "point"
        },
        {
          "type": "point"
        },
        {
          "type": "point"
        }
      ]
    }
  ]
}
{% endschema %}
