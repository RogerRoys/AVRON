<div class="xlg-s" data-xlg-part style="--s-bg:{{ section.settings.bg | default: 'transparent' }};--s-pt:{{ section.settings.pt }}px;--s-pb:{{ section.settings.pb }}px">
<section class="xlg xlg--part">
  <div class="xlg__cta" data-xrv="0"><div><b>{{ section.settings.heading }}</b>{%- if section.settings.text != blank -%}<span>{{ section.settings.text }}</span>{%- endif -%}</div><div class="xlg__ctaB">{%- for b in section.blocks -%}<a href="{{ b.settings.link | default: '/pages/contact' }}" class="{% if b.settings.style == 'outline' %}xlg__ctaS{% else %}xlg__ctaP{% endif %}" {{ b.shopify_attributes }}>{{ b.settings.label }}</a>{%- endfor -%}</div></div>
</section>
</div>
{% schema %}
{
  "name": "Guide CTA banner",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still unsure what suits your space?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Send us your room size, ceiling height and a photo. We’ll help with sizing, finishes and suitability before you choose."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ask for advice"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide CTA banner",
      "blocks": [
        {
          "type": "button"
        },
        {
          "type": "button",
          "settings": {
            "label": "Read the FAQ",
            "style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}
