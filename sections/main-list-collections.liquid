<section class="page-w sec">
  <h1 class="h1">Collections</h1>
  <div class="rooms">
    {%- for c in collections -%}
      {%- if c.handle != 'frontpage' -%}
      <a href="{{ c.url }}" class="rooms__i">
        {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
        <span class="pill">{{ c.title }} →</span>
      </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
