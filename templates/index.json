    "faq": {
      "type": "faq-support",
      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Delivery estimates are shown at checkout, and you’ll receive tracking updates as your order moves.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Request a return within 30 days of delivery. Items must be unused and in original packaging.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "Do I need an electrician?",
            "answer": "<p>Hardwired pendants, chandeliers and wall lights should be installed by a qualified electrician. Plug-in and solar lights don’t need one.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "What does IP65 mean?",
            "answer": "<p>Dust-tight and protected against water jets — suitable for exposed walls, posts and paths.</p>"
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "Can I pay in my currency?",
            "answer": "<p>Yes — USD, GBP, AUD and EUR at checkout, with Shop Pay, Apple Pay, Google Pay and PayPal.</p>"
          }
        }
