<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family={{ settings.font_family | default: 'Onest' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>:root{--font:'{{ settings.font_family | default: 'Onest' }}',system-ui,sans-serif;--ink:{{ settings.color_ink }};--bg:{{ settings.color_bg }};--soft:{{ settings.color_soft }};--line:{{ settings.color_line }};--muted:{{ settings.color_muted }};--brand:{{ settings.color_brand }};--accent:{{ settings.color_accent }};--star:{{ settings.color_star }};--logo-w:{{ settings.logo_width }}px}</style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>{{ content_for_layout }}</body>
</html>
