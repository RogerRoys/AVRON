<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ settings.font_family | default: 'Onest' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --font:'{{ settings.font_family | default: 'Onest' }}',system-ui,-apple-system,'Segoe UI',sans-serif;
      --ink:{{ settings.color_ink }};--bg:{{ settings.color_bg }};--soft:{{ settings.color_soft }};--line:{{ settings.color_line }};
      --muted:{{ settings.color_muted }};--brand:{{ settings.color_brand }};--accent:{{ settings.color_accent }};--star:{{ settings.color_star }};
      --logo-w:{{ settings.logo_width }}px;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'avron-qb.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'avron-qb.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'avron-wishlist.js' | asset_url }}" defer="defer"></script>
  <script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
  {{ content_for_header }}
<style>:root{--page-w:{{ settings.page_width | default: 1440 }}px;--text-w:{{ settings.text_page_width | default: 880 }}px}</style>
</head>
<body class="template-{{ template.name | handle }}{% if settings.anim_reveal %} anim-reveal{% endif %}{% if settings.anim_hero %} anim-hero{% endif %}{% if settings.anim_hover %} anim-hover{% endif %}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {%- if settings.cart_type == 'drawer' -%}{% section 'cart-drawer' %}{%- endif -%}
  {% render 'quick-buy' %}
  <script>
    window.routes={root:{{ routes.root_url | json }},cart_url:{{ routes.cart_url | json }},cart_add_url:{{ routes.cart_add_url | json }},cart_change_url:{{ routes.cart_change_url | json }}};
    window.moneyFormat={{ shop.money_format | json }};
    window.currencyCode={{ cart.currency.iso_code | default: shop.currency | default: 'AUD' | json }};
    window.showCurrencyCode={% if settings.currency_code_enabled %}true{% else %}false{% endif %};
    window.cartType={{ settings.cart_type | json }};
  </script>
  {% render 'wishlist-drawer' %}
  {% render 'back-to-top' %}
</body>
</html>
