[
  {
    "name": "theme_info",
    "theme_name": "Avron 1d Conversion First",
    "theme_version": "1.10.6",
    "theme_author": "Roys Studio",
    "theme_documentation_url": "https://roys.studio",
    "theme_support_url": "https://roys.studio"
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 2000,
        "step": 40,
        "unit": "px",
        "default": 1440,
        "info": "Maximum content width on large screens. Backgrounds stay full width; content is centred."
      },
      {
        "type": "checkbox",
        "id": "back_to_top",
        "label": "Show back to top button",
        "default": true,
        "info": "Appears after the first screen and scrolls smoothly back to the top."
      },
      {
        "type": "range",
        "id": "text_page_width",
        "label": "Text page width",
        "min": 600,
        "max": 1400,
        "step": 20,
        "unit": "px",
        "default": 880,
        "info": "Width of the text on standard pages (Warranty, Shipping, etc.) and policy pages (Privacy, Refund, Terms). Both use the same width."
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the Avron SVG logo in assets."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text & buttons",
        "default": "#1B1D1A"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_soft",
        "label": "Soft panels",
        "default": "#F5F3EF"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#ECE9E3"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#5C615B"
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand green",
        "default": "#2F4A3A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (sale, cart count)",
        "default": "#B5532E"
      },
      {
        "type": "color",
        "id": "color_star",
        "label": "Rating stars",
        "default": "#E3A23A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "text",
        "id": "font_family",
        "label": "Google Font family",
        "default": "Onest",
        "info": "Any family name from fonts.google.com, e.g. Onest, DM Sans, Manrope."
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "anim_reveal",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "anim_hero",
        "label": "Slow zoom on hero images",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "anim_hover",
        "label": "Image zoom on hover",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "All motion is switched off automatically for visitors who have \"reduce motion\" enabled on their device."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ]
      },
      {
        "type": "header",
        "content": "Free shipping bar"
      },
      {
        "type": "checkbox",
        "id": "cart_show_freeship",
        "label": "Show free shipping bar when the cart has products",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_freeship_empty",
        "label": "Show free shipping bar when the cart is empty",
        "default": false
      },
      {
        "type": "range",
        "id": "free_ship_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 500,
        "step": 5,
        "default": 0,
        "info": "In your store currency. 0 = everything ships free (bar shows as unlocked)."
      },
      {
        "type": "text",
        "id": "free_ship_away",
        "label": "Progress message",
        "default": "You’re [amount] away from free tracked shipping",
        "info": "[amount] is replaced with the amount left."
      },
      {
        "type": "text",
        "id": "free_ship_text",
        "label": "Unlocked message",
        "default": "You've unlocked free tracked shipping"
      },
      {
        "type": "header",
        "content": "Upsell"
      },
      {
        "type": "checkbox",
        "id": "cart_show_upsell",
        "label": "Show upsell products",
        "default": true
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Upsell collection"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Upsell heading",
        "default": "Customers also added"
      },
      {
        "type": "range",
        "id": "cart_upsell_count",
        "label": "Products to show",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 2
      },
      {
        "type": "header",
        "content": "Checkout"
      },
      {
        "type": "checkbox",
        "id": "cart_discount",
        "label": "Show discount code field",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_dynamic",
        "label": "Show accelerated checkout buttons",
        "default": true
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock threshold",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 6,
        "info": "Needs Shopify inventory tracking."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  }
]